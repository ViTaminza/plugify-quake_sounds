{
	"$schema": "https://raw.githubusercontent.com/untrustedmodders/plugify/refs/heads/main/schemas/plugin.schema.json",
	"version": "${QUAKE_SOUNDS_VERSION}",
	"name": "quake_sounds",
	"description": "Quake announcer sounds (kill streaks, first blood, headshots, knife/team/self kills, round events, C4 countdown) written directly on the native s2sdk API (no wrapper library). Ported from the Metamod:Source plugin cs2-quake-sounds (itself a port of Kandru's CounterStrikeSharp CS2 QuakeSounds). Reads the live server's quake_sounds.ini (sound names from workshop addon 3811020435 'Quake 7 Sounds') and translations/quake_sounds.phrases.txt, directly from <configs>/quake_sounds/ (HEAD paths) with the raw addons/configs and addons/translations spellings only as fallbacks. The server language is <configs>/core.cfg ServerLang, then s2sdk ServerLanguage, then en. Per-player mute, message language and volume live in the official permissions cookies under the Metamod cookie names (QuakeSounds.Muted / QuakeSounds.Lang / QuakeSounds.Volume). The !qs menu is a native s2sdk menu; when the optional hudmenu plugin is installed its per-player !menu choice (chat/centerhtml/wasd/hud) is honoured, otherwise the old HUD_LAYOUT fallback is used; per-player volume of the soundevents is applied with the dynamically resolved SosSetSoundEventParams message (no hardcoded id), exactly like the original. No exported methods.",
	"author": "Kalle (Kandru), ezekutor, Metamod port; ported to Plugify",
	"website": "https://github.com/untrustedmodders/plugify",
	"license": "GPL-3.0",
	"entry": "bin/quake_sounds",
	"platforms": [],
	"language": "cpp",
	"dependencies": [
		{
			"name": "s2sdk",
			"constraints": ">=2.18.2"
		},
		{
			"name": "permissions",
			"constraints": ">=1.3.1",
			"optional": true
		},
		{
			"name": "hudmenu",
			"constraints": ">=1.0.0",
			"optional": true
		}
	],
	"methods": []
}
